<%# LLM Call Card - Shows LLM response with tool calls (intent) and web search results %>
<div class="card border-primary" data-task-timeline-target="eventCard">
  <div class="card-header bg-primary bg-opacity-10 cursor-pointer"
       data-action="click->task-timeline#toggleCard"
       data-bs-toggle="collapse"
       data-bs-target="#llm-response-<%= response.id %>">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h6 class="mb-0">
          <i class="bi bi-chat-left-text"></i> LLM Response
          <% if response.used_tool?("web_search") %>
            <span class="badge bg-info"><i class="bi bi-search"></i> Web Search</span>
          <% end %>
          <% if response.tool_calls.present? %>
            <span class="badge bg-warning text-dark"><%= response.tool_calls.count %> tool call<%= response.tool_calls.count == 1 ? '' : 's' %></span>
          <% end %>
        </h6>
      </div>
      <div>
        <small class="text-muted"><%= timestamp.strftime("%H:%M:%S.%L") %></small>
        <i class="bi bi-chevron-down ms-2"></i>
      </div>
    </div>
  </div>

  <div id="llm-response-<%= response.id %>" class="collapse">
    <div class="card-body">
      <!-- Tool Calls (Intent) -->
      <% if response.tool_calls.present? %>
        <div class="mb-3">
          <h6 class="text-warning">
            <i class="bi bi-lightning"></i> Tool Calls (Intent)
          </h6>
          <% response.tool_calls.each do |tool_call| %>
            <div class="card bg-warning bg-opacity-10 mb-2">
              <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <strong><%= tool_call["function_name"] || tool_call[:function_name] %></strong>
                    <small class="text-muted d-block">ID: <%= tool_call["id"] || tool_call[:id] %></small>
                  </div>
                  <span class="badge bg-warning text-dark">Intent</span>
                </div>
                <% arguments = tool_call["arguments"] || tool_call[:arguments] %>
                <% if arguments.present? %>
                  <details class="mt-2">
                    <summary class="text-muted" style="cursor: pointer;">Arguments</summary>
                    <pre class="mb-0 mt-2 code-block-scrollable"><code><%= JSON.pretty_generate(arguments) %></code></pre>
                  </details>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Web Search Results -->
      <% web_search_data = response.tool_output_for("web_search") %>
      <% if web_search_data.present? %>
        <div class="mb-3">
          <h6 class="text-info">
            <i class="bi bi-search"></i> Web Search
            <span class="badge bg-info"><%= web_search_data.length %> search<%= web_search_data.length == 1 ? '' : 'es' %></span>
          </h6>

          <% web_search_data.each do |search| %>
            <div class="card bg-info bg-opacity-10 mb-2">
              <div class="card-body p-2">
                <% query = search["query"] || search[:query] %>
                <% if query.present? %>
                  <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-search me-2 text-info"></i>
                    <strong>"<%= query %>"</strong>
                  </div>
                <% end %>

                <% sources = search["sources"] || search[:sources] || [] %>
                <% if sources.any? %>
                  <div class="ms-3">
                    <small class="text-muted d-block mb-1"><%= sources.length %> source<%= sources.length == 1 ? '' : 's' %> found:</small>
                    <% sources.each do |source| %>
                      <div class="d-flex align-items-start mb-1">
                        <i class="bi bi-link-45deg me-1 text-muted mt-1" style="font-size: 0.75rem;"></i>
                        <div>
                          <a href="<%= source["url"] || source[:url] %>" target="_blank" rel="noopener noreferrer"
                             class="text-decoration-none small">
                            <%= source["title"] || source[:title] || source["url"] || source[:url] %>
                          </a>
                          <% snippet = source["snippet"] || source[:snippet] %>
                          <% if snippet.present? %>
                            <br><small class="text-muted"><%= truncate(snippet, length: 150) %></small>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% citations = search["citations"] || search[:citations] || [] %>
                <% if citations.any? %>
                  <details class="mt-2 ms-3">
                    <summary class="text-muted small" style="cursor: pointer;">
                      <i class="bi bi-quote"></i> <%= citations.length %> citation<%= citations.length == 1 ? '' : 's' %> in response
                    </summary>
                    <div class="mt-1">
                      <% citations.each do |citation| %>
                        <div class="small mb-1">
                          <a href="<%= citation["url"] || citation[:url] %>" target="_blank" rel="noopener noreferrer"
                             class="text-decoration-none">
                            <i class="bi bi-link-45deg"></i> <%= citation["title"] || citation[:title] %>
                          </a>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Response Text -->
      <% if response.response_text.present? %>
        <div class="mb-3">
          <h6><i class="bi bi-chat-quote"></i> Response Text</h6>
          <div class="p-3 bg-light rounded">
            <%= simple_format(response.response_text) %>
          </div>
        </div>
      <% end %>

      <!-- Metadata -->
      <details>
        <summary class="text-muted" style="cursor: pointer;">Metadata</summary>
        <div class="mt-2">
          <table class="table table-sm">
            <tr>
              <th>Model</th>
              <td><%= response.model %></td>
            </tr>
            <tr>
              <th>Provider</th>
              <td><%= response.provider %></td>
            </tr>
            <tr>
              <th>Tokens</th>
              <td>
                <%= response.tokens_prompt %> prompt +
                <%= response.tokens_completion %> completion =
                <%= response.tokens_total %> total
              </td>
            </tr>
            <% if response.cost_usd.present? %>
              <tr>
                <th>Cost</th>
                <td>$<%= response.cost_usd %></td>
              </tr>
            <% end %>
          </table>
        </div>
      </details>
    </div>
  </div>
</div>

<style>
.cursor-pointer {
  cursor: pointer;
}

.card-header:hover {
  background-color: rgba(13, 110, 253, 0.15) !important;
}

.bi-chevron-down {
  transition: transform 0.2s;
}

.collapsed .bi-chevron-down {
  transform: rotate(-90deg);
}
</style>
